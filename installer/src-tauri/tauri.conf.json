{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VANTA Setup",
  "version": "1.0.0",
  "identifier": "app.vanta.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "setup",
        "title": "Instalar VANTA",
        "url": "index.html",
        "width": 600,
        "height": 420,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../src-tauri/icons/32x32.png", "../../src-tauri/icons/128x128.png", "../../src-tauri/icons/icon.ico"]
  }
}
