{
  "name": "vanta",
  "version": "1.0.0",
  "description": "VANTA — Dynamic Island premium para Windows.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "extension:build": "node scripts/build-extension.mjs",
    "icons": "tauri icon assets/vanta-icon.svg",
    "release": "node scripts/build-setup.mjs",
    "release:setup-only": "node scripts/build-setup.mjs --skip-app",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-global-shortcut": "2.4.1",
    "@tauri-apps/plugin-notification": "2.7.0",
    "@tauri-apps/plugin-opener": "2.7.2",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
